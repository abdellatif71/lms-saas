generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum OrgStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}
enum MemberRole {
  ORG_OWNER
  ORG_ADMIN
  TEACHER
  STUDENT
  PARENT
}
enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}
enum VerificationType {
  EMAIL_VERIFY
  PASSWORD_RESET
}
enum FilePurpose {
  COURSE_COVER
  LESSON_VIDEO
  LESSON_PDF
  LESSON_IMAGE
  SUBMISSION_FILE
  CERTIFICATE_PDF
  ORG_LOGO
  AVATAR
}
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum CourseVisibility {
  PRIVATE
  ORG
  PUBLIC
}
enum EnrollmentRule {
  OPEN
  INVITE_ONLY
}
enum LessonContentType {
  TEXT
  VIDEO
  PDF
  EXTERNAL
}
enum LessonCompletionRule {
  VIEW
  MANUAL
  TIME_BASED
}
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}
enum LessonProgressState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LearningEventType {
  LESSON_STARTED
  LESSON_HEARTBEAT
  LESSON_COMPLETED
  LESSON_PAUSED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String
  name            String
  locale          String     @default("en")
  emailVerifiedAt DateTime?
  totpSecret      String?
  totpEnabled     Boolean    @default(false)
  status          UserStatus @default(ACTIVE)
  isSuperAdmin    Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  sessions           Session[]
  verificationTokens VerificationToken[]
  memberships        Membership[]
  auditLogs          AuditLog[]
  files              File[]             @relation("FileUploadedBy")
  authoredCourses    Course[]           @relation("CourseAuthor")
  enrollments        Enrollment[]       @relation("StudentEnrollments")
  lessonProgress     LessonProgress[]   @relation("StudentLessonProgress")
  learningEvents     LearningEvent[]
  learningTimeBuckets LearningTimeBucket[]
  @@index([status])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      VerificationType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, type])
  @@index([expiresAt])
}

model Organization {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  slug          String    @unique
  description   String?
  logoFileId    String?   @db.Uuid
  defaultLocale String    @default("en")
  status        OrgStatus @default(ACTIVE)
  settings      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  files       File[]
  courses     Course[]
  categories  Category[]
  enrollments Enrollment[]
  lessonProgress LessonProgress[]
  @@index([status])
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organizationId String       @db.Uuid
  role           MemberRole
  status         MemberStatus @default(INVITED)
  invitedById    String?      @db.Uuid
  joinedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@index([organizationId, status])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           MemberRole
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, email])
  @@index([expiresAt])
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @db.Uuid
  organizationId String?  @db.Uuid
  action         String
  targetType     String?
  targetId       String?
  metadata       Json     @default("{}")
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())
  actor        User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action])
}

model File {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  uploadedById   String      @db.Uuid
  storageKey     String      @unique
  sizeBytes      BigInt
  mimeType       String
  originalName   String
  checksum       String?
  purpose        FilePurpose
  createdAt      DateTime    @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  lessons      Lesson[]
  @@index([organizationId, purpose])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses      Course[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Course {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  authorId       String           @db.Uuid
  categoryId     String?          @db.Uuid
  title          String
  slug           String
  description    String?
  coverFileId    String?          @db.Uuid
  visibility     CourseVisibility @default(ORG)
  enrollmentRule EnrollmentRule   @default(OPEN)
  status         CourseStatus     @default(DRAFT)
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User         @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules      Module[]
  enrollments  Enrollment[]
}

model Module {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  title     String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, position])
}

model Lesson {
  id               String               @id @default(uuid()) @db.Uuid
  moduleId         String               @db.Uuid
  title            String
  position         Int
  contentType      LessonContentType
  bodyText         String?
  externalUrl      String?
  fileId           String?              @db.Uuid
  estimatedMinutes Int?
  completionRule   LessonCompletionRule @default(VIEW)
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  file   File?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  progress LessonProgress[]
  learningEvents LearningEvent[]
  learningTimeBuckets LearningTimeBucket[]

  @@index([moduleId, position])
  @@index([moduleId, deletedAt])
}

model Enrollment {
  id             String           @id @default(uuid()) @db.Uuid
  courseId       String           @db.Uuid
  studentUserId  String           @db.Uuid
  organizationId String           @db.Uuid
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  course      Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentUser User   @relation("StudentEnrollments", fields: [studentUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentUserId])
  @@index([organizationId, studentUserId])
  @@index([courseId, status])
}

model LessonProgress {
  id                  String              @id @default(uuid()) @db.Uuid
  lessonId            String              @db.Uuid
  studentUserId       String              @db.Uuid
  organizationId      String              @db.Uuid
  state               LessonProgressState @default(NOT_STARTED)
  lastPositionSeconds Int                 @default(0)
  completedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentUser  User         @relation("StudentLessonProgress", fields: [studentUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentUserId])
  @@index([organizationId, studentUserId])
  @@index([studentUserId, state])
}

model LearningTimeBucket {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  lessonId   String   @db.Uuid
  bucketDate DateTime @db.Date
  totalMs    Int      @default(0)
  eventCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, bucketDate])
  @@index([userId, bucketDate])
  @@index([lessonId, bucketDate])
}

model LearningEvent {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  lessonId   String            @db.Uuid
  type       LearningEventType
  durationMs Int?
  metadata   Json?
  createdAt  DateTime          @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId, createdAt])
  @@index([lessonId, type, createdAt])
}
